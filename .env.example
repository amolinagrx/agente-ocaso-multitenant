OCASO_ENV=production
SECRET_KEY=replace-with-at-least-32-random-bytes
DATA_DIR=/data
# SQLite compatible; PostgreSQL recomendado para carga comercial:
DATABASE_URL=sqlite:////data/ocaso.db

# Se acepta también DEFAULT_Tenant_ID por compatibilidad con la especificación.
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
DEFAULT_TENANT_NAME=Oficina inicial
DEFAULT_TENANT_SUBDOMAIN=oficina-inicial
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password

TENANT_RESOLUTION_METHOD=subdomain
TENANT_BASE_DOMAIN=gestion.ocasoarmilla.es
RECOVERY_MASTER_KEY=replace-with-a-long-random-recovery-key
RESET_CODE=replace-with-a-separate-random-reset-code

DEEPSEEK_API_KEY=
GOOGLE_DRIVE_ENABLED=0
